# 복사해서 .env 로 쓰세요:  cp .env.example .env
# SESSION_SECRET 은 반드시 새로 만들어야 합니다:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-please
PORT=8888

# 초대 링크에 박히는 주소. 회원들이 실제로 접속하는 주소를 넣으세요 (예: http://192.168.0.10:8888).
# 비워 두면 요청이 들어온 주소를 씁니다 → 회장이 localhost 로 열면 초대 링크도 localhost 가 됩니다.
PUBLIC_BASE_URL=

# sqlite 파일이 쌓이는 위치 (도커에서는 볼륨으로 마운트)
DATA_DIR=./data

# 첫 관리자 계정. 계정이 하나도 없을 때만 이 값으로 만듭니다 (이후로는 무시).
# ⚠️ 아래 기본값 그대로 쓰지 마세요. DB 를 초기화할 때마다 되살아납니다:
#    node -e "console.log('sb-'+require('crypto').randomBytes(9).toString('base64url'))"
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=관리자
ADMIN_INITIAL_PASSWORD=change-me-too

# https 로 서비스할 때만 true (리버스 프록시 뒤에 둘 경우)
COOKIE_SECURE=false
# 세션 유지 기간(일)
SESSION_DAYS=30
