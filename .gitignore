# ── 의존성 / 빌드 산출물 ──────────────────────────────
node_modules/
*.log
npm-debug.log*

# ── 비밀값 ────────────────────────────────────────────
# .env.example 만 커밋합니다.
.env
.env.*
!.env.example

# ── 런타임 데이터 (SQLite) ────────────────────────────
# data/ 디렉터리 자체는 .gitkeep 으로 남기고 내용물은 전부 제외합니다.
data/*
!data/.gitkeep

# ── 클로드 / 에이전트 컨텍스트 ────────────────────────
.claude/
CLAUDE.md
AGENTS.md

# ── 설계·기획 자료 ────────────────────────────────────
design_handoff_surfboard/
docs/

# ── README 스크린샷 원본 (마스킹 전, 실명·토큰 포함) ──
readme-assets/*.orig

# ── 에디터 / OS ───────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
